# Beispiel-Konfiguration für den Server (als .env kopieren; .env wird nicht eingecheckt)

# Adresse/Port, auf dem der Server lauscht. Im Container 0.0.0.0, lokal 127.0.0.1.
HOST=127.0.0.1
PORT=8080

# Ablage der SQLite-Datenbank (im Container: Volume /data)
DATA_DIR=./data

# Registrierung: invite (nur mit Einladungscode, Standard) | open | closed
REGISTRATION=invite

# Hinter einem Reverse Proxy: dessen Adresse(n) vertrauen, damit Client-IP (Rate-Limit) und https erkannt werden.
# true | false | Anzahl Hops | IP/CIDR-Liste, z. B. 127.0.0.1,172.16.0.0/12
TRUST_PROXY=false

# Session-Cookie nur über https (in Produktion true lassen; nur für http://localhost-Tests false)
COOKIE_SECURE=true

# Sitzungsdauer in Tagen (verlängert sich bei Nutzung)
SESSION_DAYS=30

# Maximale Tresorgröße in Byte
MAX_VAULT_BYTES=5242880

LOG_LEVEL=info
