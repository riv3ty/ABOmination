# Konfiguration – als .env kopieren und anpassen (.env wird nicht eingecheckt).
# Docker (compose.yaml) liest die Werte im ersten Block. Für "npm start" ohne Docker gelten zusätzlich die unteren.

# ---------- Docker / allgemein ----------

# Registrierung: invite (nur mit Einladungscode, Standard) | open | closed
REGISTRATION=invite

# Hinter dem Reverse Proxy: dessen Adresse(n) vertrauen, damit Client-IP (Sperre nach Fehlversuchen) und https erkannt werden.
# true | false | Anzahl Hops | IP/CIDR-Liste, z. B. 127.0.0.1,172.16.0.0/12
# In Docker ist "true" richtig, solange der Container-Port nur lokal bzw. im Proxy-Netz erreichbar ist.
TRUST_PROXY=true

# Session-Cookie nur über https (in Produktion true lassen; false nur für Tests über http://localhost)
COOKIE_SECURE=true

# Sitzungsdauer in Tagen (verlängert sich bei Nutzung)
SESSION_DAYS=30

# Maximale Tresorgröße in Byte (Reverse Proxy muss mindestens so große Anfragen erlauben)
MAX_VAULT_BYTES=5242880

LOG_LEVEL=info

# Nur Docker: Image-Version von ghcr.io/riv3ty/abomination (latest oder z. B. 0.5.0)
ABO_VERSION=latest

# Nur Docker: Adresse/Port auf dem Host, auf den der Reverse Proxy zugreift
BIND_ADDR=127.0.0.1
HOST_PORT=8080

# ---------- nur ohne Docker (npm start) ----------
# HOST=127.0.0.1
# PORT=8080
# DATA_DIR=./data
